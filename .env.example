# Copy this file to .env and change the passwords. .env is not committed.
# Use only letters and digits in the values.
POSTGRES_DB=signup
POSTGRES_USER=signup
POSTGRES_PASSWORD=change-me

RABBITMQ_USER=signup
RABBITMQ_PASSWORD=change-me

# Password of the user that copies data from the primary database to the standby.
POSTGRES_REPLICATION_PASSWORD=change-me-too

# Shared secret of the three RabbitMQ nodes: nodes with the same value form one cluster.
RABBITMQ_ERLANG_COOKIE=change-me-to-a-long-random-string
